#!/usr/bin/env python3
"""Demo stand-in for `claude`: the test stub (tests/stubs/claude), with two answers of its own for record.sh.

  - The relay of Send changes to session (send.deliver: its prompt holds <<<MESSAGE markers) calls SendMessage.
  - Any other call, a side chat, answers with the text of the file DEMO_CHAT_REPLY, when that is set.
Everything else (STUB_CLAUDE_* variables) is the test stub's.
"""
import os
import subprocess
import sys
from pathlib import Path

stub = Path(__file__).resolve().parents[2] / 'tests' / 'stubs' / 'claude'
prompt = '' if sys.argv[1:] == ['--version'] else sys.stdin.read()
env = dict(os.environ)
if '<<<MESSAGE' in prompt:
    env.update(STUB_CLAUDE_SEND='ok', STUB_CLAUDE_RESULT='SENT')
elif os.environ.get('DEMO_CHAT_REPLY'):
    env['STUB_CLAUDE_RESULT'] = Path(os.environ['DEMO_CHAT_REPLY']).read_text(encoding='utf-8').strip()
sys.exit(subprocess.run([sys.executable, str(stub), *sys.argv[1:]], input=prompt, text=True, env=env).returncode)
