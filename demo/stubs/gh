#!/usr/bin/env python3
"""gh for demo/record.sh: PR 4242 of acme/billing, answered from the scratch repo in $DEMO_REPO. Never reaches GitHub."""
import json
import os
import subprocess
import sys

args = sys.argv[1:]
repo = os.environ['DEMO_REPO']
head = subprocess.run(['git', '-C', repo, 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
VIEW = {'headRefOid': head, 'baseRefName': 'main', 'author': {'login': 'dev-one'}, 'number': 4242, 'state': 'OPEN',
        'url': 'https://github.com/acme/billing/pull/4242', 'reviews': [],
        'commits': [{'oid': head, 'messageHeadline': 'Add coupons and retries', 'authors': [{'login': 'dev-one'}],
                     'committedDate': '2026-10-24T10:00:00Z'}]}

if args[:2] == ['api', 'user']:
    print('demo-reviewer' if '--jq' in args else json.dumps({'login': 'demo-reviewer'}))
elif args[:2] == ['pr', 'view']:
    print(json.dumps(VIEW))
elif args[:2] == ['pr', 'diff']:
    sys.stdout.write(subprocess.run(['git', '-C', repo, 'diff', 'origin/main', 'HEAD'], capture_output=True, text=True).stdout)
elif args[:1] == ['api'] and len(args) > 1 and args[1].endswith('/reviews'):
    print(json.dumps({'id': 9001, 'html_url': 'https://github.com/acme/billing/pull/4242#pullrequestreview-9001'}
                     if '--method' in args or 'POST' in args else []))
elif args[:2] == ['auth', 'status']:
    print('github.com\n  ✓ Logged in to github.com account demo-reviewer')
else:
    sys.stderr.write('demo gh: no answer for: ' + ' '.join(args) + '\n')
    sys.exit(1)
